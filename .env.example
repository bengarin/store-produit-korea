# Copier ce fichier en « .env.local » (jamais commité) puis adapter.
# ⚠️ Les variables VITE_* sont visibles par tous dans le navigateur : n'y mettez AUCUN secret.

# URL de l'API REST du backend. Laisser vide = le site utilise ses données locales (mode actuel).
VITE_API_BASE_URL=

# Délai maximal d'une requête API en millisecondes (optionnel).
VITE_API_TIMEOUT_MS=10000

# API d'administration (/admin). Déduite automatiquement si VITE_API_BASE_URL finit par /store.
# À renseigner seule pour utiliser l'admin alors que la boutique reste en mode démo. Ex. : /api/v1/admin
VITE_ADMIN_API_BASE_URL=

# Pixel Meta (identifiant PUBLIC, pas un secret). Par défaut : 1665012938525216.
# Actif seulement en mode API, après consentement du visiteur. « off » = pixel désactivé.
# Ne JAMAIS mettre ici le jeton d'accès de la Conversions API : il reste côté serveur.
VITE_META_PIXEL_ID=1665012938525216
