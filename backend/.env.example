# Copier en backend/.env puis remplir. NE JAMAIS COMMITER backend/.env.
# Valeurs ci-dessous = exemples fictifs pour le développement local.

# --- Django ---
# (manage.py utilise config.settings.dev ; pytest utilise config.settings.test ;
#  le serveur de production devra définir DJANGO_SETTINGS_MODULE=config.settings.prod)
# Obligatoire en production. Générer : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origines autorisées à envoyer des requêtes avec cookie CSRF (front Vite en dev)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- MySQL (utilisé par Django ET par docker-compose.yml) ---
DB_NAME=mapetitecoree
DB_USER=mpc_app
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# Uniquement pour le conteneur MySQL local
MYSQL_ROOT_PASSWORD=
