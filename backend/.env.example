# Copier en backend/.env puis remplir. NE JAMAIS COMMITER backend/.env.
# Valeurs ci-dessous = exemples fictifs pour le développement local.

# --- Django ---
# (manage.py utilise config.settings.dev ; pytest utilise config.settings.test ;
#  le serveur de production devra définir DJANGO_SETTINGS_MODULE=config.settings.prod)
# Obligatoire en production. Générer : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origines autorisées à envoyer des requêtes avec cookie CSRF (front Vite en dev)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- MySQL (utilisé par Django ET par docker-compose.yml) ---
DB_NAME=mapetitecoree
DB_USER=mpc_app
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# Uniquement pour le conteneur MySQL local
MYSQL_ROOT_PASSWORD=

# --- Phase 7 : production ---
# Lecture du fichier .env : chemin d'un autre fichier, ou « none » pour ne lire QUE les variables
# d'environnement du système (recommandé en production : systemd EnvironmentFile=/etc/mpc/production.env)
# DJANGO_ENV_FILE=none
# Nombre de relais (nginx…) devant Django qui REMPLACENT X-Forwarded-For. 0 = Django reçoit les visiteurs
# directement. Avec deploy/nginx.conf.example : 1. Une valeur fausse = limites anti-abus contournables.
TRUSTED_PROXY_COUNT=0
# Préchargement HSTS : laisser false tant que le domaine définitif n'est pas en HTTPS partout
# DJANGO_HSTS_PRELOAD=false

# --- Référencement ---
# Adresse publique canonique (https, sans / final). Vide en développement.
SITE_URL=
# Dossier du front construit (npm run build). Par défaut : ../dist
# FRONTEND_DIST_DIR=/srv/mpc/dist

# --- E-mails (laisser VIDE tant que le fournisseur n'est pas choisi : rien ne part, tout est journalisé) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
# Expéditeur, ex. « Ma Petite Corée <commandes@votre-domaine.ma> » — adresse du domaine réel
DEFAULT_FROM_EMAIL=
# Destinataires des alertes « nouvelle commande », séparés par des virgules
ORDER_NOTIFICATION_EMAILS=
